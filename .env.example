# commerce_ai_generator 서버 환경변수 (값은 .env 에만, 저장소에는 키 이름만)
# React(ui_ux)에는 어떤 키도 넣지 않는다 — DeepSeek 키는 이 서버만 읽는다.

# ── DB (셋 중 하나만, 값이 다르면 기동 오류) ─────────────
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/dashboard_db
# COMMERCE_DB_URL=
# FRUIT_DB_URL=

# ── API 서버 ───────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8001

# ── LLM (NLU·보유량 해석) ────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 대화 라우팅에 NLU 사용 (사전 테이블 이관 후). 0 이면 규칙만 사용
CHAT_NLU_ENABLED=1
# DB 대신 사전 JSON 을 쓸 때 (scripts.migrate_nlu_dictionary --export-json 결과)
# NLU_DICTIONARY_JSON=/srv/commerce/nlu_dictionary.json

# ── 레시피 ─────────────────────────────────────────────
# 레시피 목록: 비우면 DB recipe_catalog 테이블 (scripts.import_recipe_catalog 로 넣음)
# RECIPE_CATALOG_JSON=/srv/commerce/recipes.json
# 사용할 레시피 출처 (2026-10-29: 농사로 향토·종가음식은 사용 안 함). all = 전부
RECIPE_CATALOG_SOURCES=foodsafety,epis
# 사진을 보여 줄 출처 (이용 조건을 확인한 출처만, 쉼표로 구분)
RECIPE_IMAGE_SOURCES=foodsafety
# 쉽게 보기 (AI가 원문을 다듬고 서버가 원문과 대조): on=없으면 백그라운드 생성 · cache=미리 만든 것만 · off
# DeepSeek 키가 있어야 생성됨. 결과는 recipe_easy_view 테이블에 저장 (scripts.recipe_chat_db init)
RECIPE_EASY_VIEW=on
# 원문 사진이 없는 레시피의 맨 위 사진 (AI 생성 · 카드에 'AI 생성 예시 이미지' 표시)
# OPENAI_API_KEY 가 있어야 생성됨. 레시피마다 한 번만 만들어 recipe_ai_image 테이블에 저장
RECIPE_AI_IMAGE=on
RECIPE_AI_IMAGE_MODEL=gpt-image-1
# gpt-image-1 은 OpenAI 조직 인증이 필요할 수 있어요. 인증 전에는 dall-e-3 (크기 1792x1024, 품질 standard/hd 로 자동 변환)
RECIPE_AI_IMAGE_QUALITY=medium
RECIPE_AI_IMAGE_SIZE=1536x1024
# 하루 최대 생성 수 (비용 상한)
RECIPE_AI_IMAGE_DAILY_LIMIT=30

# ── 관리자 백엔드 (/admin: 운영 탭 · B2B 탭) ─────────────────
# 로그인 토큰. 클라우드에서는 반드시 길게 설정 (없으면 실행할 때마다 임시 토큰을 로그에 출력)
ADMIN_ACCESS_TOKEN=
# 관리자 데이터 폴더 (입찰 DB · 생성한 견적요청서·제안서). 기본: data/admin
# ADMIN_DATA_DIR=/srv/commerce/data/admin
# B2B 입찰·근거 DB (기본 SQLite: data/admin/b2b.sqlite3). 운영은 Postgres 권장
# B2B_DB_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/dashboard_db
# 관리자 화면 LLM (공고 조건 추출 · 제안서 문장): none | deepseek | openai | anthropic (없으면 LLM_PROVIDER)
ADMIN_LLM_PROVIDER=deepseek
# 나라장터 입찰 공고 수집 (python -m scripts.admin.collect_bids)
# G2B_SERVICE_KEY=
# 결제 뼈대 (키가 없으면 비활성 — 관리자 화면에서 상태만 확인)
# TOSS_SECRET_KEY= / STRIPE_SECRET_KEY= / PAYPAL_CLIENT_SECRET=

# 네이버 쇼핑커넥트 등록부 (2026-11-02) — 브랜드커넥트에서 발급한 링크를 적은 CSV. 비우면 쇼핑커넥트 목록을 보여 주지 않음
# NAVER_CONNECT_REGISTRY_CSV=data/naver_connect_links.csv
# 등록 링크가 없는 검색어·급상승 식품을 발급 요청 대기열에 쌓기 (1=켬). 대기열 DB 기본 data/affiliate/shopping_connect.sqlite3
# SC_REQUEST_QUEUE=1
# SC_DB_PATH=data/affiliate/shopping_connect.sqlite3
# 쇼핑커넥트를 사이트 대화·MCP 화면에 보여 줄지 — 2026-11-04 네이버 회신: 자체 웹/앱 사용 불가 → 0 유지
# (네이버가 외부 웹/앱 활동 허용을 공지하면 1). 0 이어도 블로그 초안의 '발급이 필요한 상품' 점검은 동작
# NAVER_CONNECT_ON_SITE=0
# MCP 도구 (python -m app.mcp_adapter.server, 로컬 stdio) — 제휴 링크를 AI 에이전트 경유로 보여 줄지 (정책 확인 전 0)
# MCP_AFFILIATE_LINKS=0
# 쇼핑 답변 아래 네이버쇼핑 검색 링크(제휴 아님, 고객 편의용) — 기본 켬, 0 이면 끔
# NAVER_SEARCH_LINKS=1

# 도매꾹 Open API (B2B 도매몰 검색 · 2026-11-04) — 키는 .env 에만
DOMEGGOOK_API_KEY=

# 국립종자원 품종코드 (2026-11-11) — 농림축산식품 공공데이터포털(data.mafra.go.kr)에서 발급한 키
#   품종 이름 확인용 목록 내려받기: uv run python scripts/sync_seed_varieties.py → data/reference/seed_varieties.json
SEED_VARIETY_API_KEY=
