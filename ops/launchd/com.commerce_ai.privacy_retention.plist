<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매일 04:20 보존 기간 작업(접고 지우기, scripts/privacy_retention.py). 설치: ops/launchd/install_privacy_retention.sh -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.commerce_ai.privacy_retention</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/run_privacy_retention.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/var/log/privacy_retention.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/var/log/privacy_retention.launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
