<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 지금 뜨는 식품: 매일 10:00 검색량 급상승 리포트 생성 (이 맥북 전용 실행 설정 · 운영 코드 아님)
     등록: cp 이 파일 ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.commerce_ai.trend_surge.plist
     해제: launchctl bootout gui/$(id -u)/com.commerce_ai.trend_surge -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.commerce_ai.trend_surge</string>
  <key>WorkingDirectory</key><string>/Users/mom/commerce_ai_generator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mom/commerce_ai_generator/.venv/bin/python</string>
    <string>-m</string>
    <string>scripts.update_trend_surge</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/mom/commerce_ai_generator/var/trends/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/mom/commerce_ai_generator/var/trends/launchd.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
