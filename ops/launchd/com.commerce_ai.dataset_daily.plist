<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매일 04:40 학습 데이터셋 승격·정리 (scripts/dataset_daily.py). 설치: ops/launchd/install_dataset_daily.sh -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.commerce_ai.dataset_daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/run_dataset_daily.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/var/log/dataset_daily.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/var/log/dataset_daily.launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
