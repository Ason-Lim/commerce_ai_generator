from pathlib import Path

from app.services.market.delivery_policy import (
    build_platform_delivery_policy,
    calculate_delivery_score,
)
from app.services.market.partner_market_adapter import (
    extract_partner_market_items,
)
from app.services.market.platform_matcher import (
    detect_platform_from_item,
    detect_platform_from_mall_name,
    normalize_mall_name,
)
from app.services.market.registry import (
    PLATFORM_REGISTRY,
    PlatformConfig,
    get_enabled_platform_ids,
    get_partner_platform_ids,
    get_platform_config,
    list_platform_configs,
    platform_config_to_dict,
    require_platform_config,
)

from app.services.market.normalizer import (
    normalize_market_item,
    normalize_market_items,
)
from app.services.market.partner_market_adapter import (
    extract_partner_market_items,
)
from app.services.market.platform_matcher import (
    detect_platform_from_mall_name,
    normalize_mall_name,
)
from app.services.market.registry import (
    PLATFORM_REGISTRY,
    PlatformConfig,
    get_enabled_platform_ids,
    get_partner_platform_ids,
    get_platform_config,
    list_platform_configs,
    platform_config_to_dict,
    require_platform_config,
)

path = Path("app/services/market/__init__.py")
text = path.read_text(encoding="utf-8")

content = '''from app.services.market.delivery_policy import (
    build_platform_delivery_policy,
    calculate_delivery_score,
)

import_block = '''from app.services.market.normalizer import (
    normalize_market_item,
    normalize_market_items,
)
'''

if import_block not in text:
    marker = (
        "from app.services.market.partner_market_adapter import ("
    )

    text = text.replace(
        marker,
        import_block + marker,
        1,
    )

for name in [
    '"normalize_market_item",',
    '"normalize_market_items",',
]:
    if name not in text:
        text = text.replace(
            '    "normalize_mall_name",',
            f'    {name}\n'
            '    "normalize_mall_name",',
            1,
        )

path.write_text(text, encoding="utf-8")
print("updated:", path)


__all__ = [
    "PLATFORM_REGISTRY",
    "PlatformConfig",
    "get_enabled_platform_ids",
    "get_partner_platform_ids",
    "get_platform_config",
    "list_platform_configs",
    "build_platform_delivery_policy",
    "calculate_delivery_score",
    "extract_partner_market_items",
    "detect_platform_from_mall_name",
    "normalize_mall_name",
    "normalize_market_it"
    "normalize_market_item",
    "normalize_market_items",
    "platform_config_to_dict",
    "require_platform_config",


    # Search URL
    "build_platform_search_url",
    "build_kurly_search_url",
    "build_ssg_search_url",
    "normalize_search_keyword",
    "normalize_platform_name",
    "build_kurly_search_url",
    "build_ssg_search_url",
]
'''

path.write_text(content, encoding="utf-8")
print("updated:", path)