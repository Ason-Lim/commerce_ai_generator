{
  "manifest_version": 3,
  "name": "commerce_ai — 브랜드커넥트 링크를 등록부에 저장",
  "version": "0.6.0",
  "description": "브랜드커넥트에서 사람이 발급한 쇼핑커넥트 링크를 버튼 한 번으로 commerce_ai 등록부(naver_connect_links.csv)에 저장합니다. 브랜드커넥트 API 를 스스로 부르지 않습니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "브랜드커넥트를 이 창 오른쪽 절반에 열기 (분할 화면)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://brandconnect.naver.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://brandconnect.naver.com/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://brandconnect.naver.com/*"
      ],
      "js": [
        "lib/registry_row.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
