{
  "manifest_version": 3,
  "name": "commerce_ai — 브랜드커넥트 링크를 등록부에 저장",
  "version": "0.1.0",
  "description": "브랜드커넥트에서 사람이 발급한 쇼핑커넥트 링크를 버튼 한 번으로 commerce_ai 등록부(naver_connect_links.csv)에 저장합니다. 브랜드커넥트 API 를 스스로 부르지 않습니다.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://brandconnect.naver.com/*"],
      "js": ["page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://brandconnect.naver.com/*"],
      "js": ["lib/registry_row.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
